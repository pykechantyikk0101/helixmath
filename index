            }
            
            document.getElementById('question-text').innerHTML = currentQuestion.q;
            
            let options = [...currentQuestion.options];
            let attempts = 0;
            do {
                for (let i = options.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [options[i], options[j]] = [options[j], options[i]];
                }
                attempts++;
            } while (isRetry && options.length > 1 && JSON.stringify(options) === JSON.stringify(lastDisplayedOptions) && attempts < 10);
            
            lastDisplayedOptions = [...options];
            
            const container = document.getElementById('quiz-options');
            container.innerHTML = '';
            
            options.forEach(opt => {
                let btn = document.createElement('button');
                // Updated Styling for Options using modern 3D button approach
                btn.className = 'btn-3d w-full py-4 px-5 bg-slate-900 text-white rounded-2xl transition border-2 border-slate-700 border-b-[5px] hover:border-cyan-500 text-base md:text-lg font-bold shadow-md hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] text-left flex items-center justify-between group';
