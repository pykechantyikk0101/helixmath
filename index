<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Equations Jump: Labyrinth Tower Enhanced</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load Google Fonts for Teen/Gaming Vibe -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Load FontAwesome for Cool Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Load Three.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Load jsPDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <!-- Load MathJax for Equations -->
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    
    <style>
        body { margin: 0; overflow: hidden; background-color: #030712; color: white; font-family: 'Nunito', sans-serif; touch-action: none; }
        .font-display { font-family: 'Fredoka', sans-serif; }
        #game-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
        .ui-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; pointer-events: none; }
        .interactive { pointer-events: auto; }
        .hidden { display: none !important; }
        
        .MathJax { color: white !important; font-size: 1.05em !important; }

        @keyframes pulseGlow {
            0%, 100% { filter: drop-shadow(0 0 15px rgba(59, 130, 246, 0.6)); }
            50% { filter: drop-shadow(0 0 30px rgba(59, 130, 246, 0.9)); }
        }
        .animate-glow { animation: pulseGlow 3s infinite ease-in-out; }
        
        @keyframes floatEffect {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float { animation: floatEffect 4s infinite ease-in-out; }

        @keyframes modalPop {
            0% { transform: scale(0.85); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-pop { animation: modalPop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        
        @keyframes damagePop {
            0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
            30% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
            70% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
            100% { transform: translate(-50%, -100%) scale(0.8); opacity: 0; }
        }
        .animate-damage { animation: damagePop 1s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

        /* Custom 3D Button Press Effect */
        .btn-3d { transition: all 0.1s; }
        .btn-3d:active { transform: translateY(4px); border-bottom-width: 0px !important; margin-bottom: 4px; }
    </style>
</head>
<body>

    <!-- Layar Login -->
    <div id="login-screen" class="absolute inset-0 bg-gradient-to-br from-slate-950 via-indigo-950 to-purple-950 z-50 flex flex-col items-center justify-center interactive p-4 overflow-y-auto">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(59,130,246,0.18)_0,transparent_75%)] pointer-events-none"></div>
        
        <div class="relative z-10 text-center mb-6 animate-float">
            <span class="px-4 py-1.5 bg-cyan-500/20 border border-cyan-500/40 text-cyan-300 font-bold text-xs rounded-full uppercase tracking-widest shadow-[0_0_20px_rgba(6,182,212,0.4)]"><i class="fa-solid fa-gamepad mr-1"></i> Game Edukasi Kelas X</span>
            <h1 class="font-display text-5xl md:text-7xl font-bold text-white mt-3 mb-2 tracking-wide animate-glow">EQUATIONS <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-fuchsia-400">JUMP</span></h1>
            <p class="text-indigo-200 text-sm md:text-base font-semibold max-w-md mx-auto">Taklukkan 4 Level Menara Persamaan Kuadrat!</p>
        </div>
        
        <div class="relative z-10 bg-gray-900/90 backdrop-blur-2xl p-8 rounded-3xl w-full max-w-md border border-indigo-500/30 shadow-[0_25px_60px_rgba(0,0,0,0.8)]">
            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-bold text-indigo-400 uppercase tracking-wider mb-2"><i class="fa-solid fa-user-astronaut mr-1"></i> Identitas Siswa</label>
                    <select id="player-name" class="w-full px-4 py-3.5 bg-gray-950/90 text-white font-semibold rounded-xl outline-none border-2 border-gray-800 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-500/30 transition text-sm cursor-pointer hover:border-gray-600">
                        <option value="" disabled selected>-- Pilih Nama Siswa --</option>
                        <option value="Achmad Naufal Dzaky Zahid">Achmad Naufal Dzaky Zahid</option>
                        <option value="Aliyah Hafidzah Naurah Arsy">Aliyah Hafidzah Naurah Arsy</option>
                        <option value="Ardiansyah Fahmi Wicaksana">Ardiansyah Fahmi Wicaksana</option>
                        <option value="Azzam Krisna Zamputro">Azzam Krisna Zamputro</option>
                        <option value="Danesh Fathan Ali Ibrahim">Danesh Fathan Ali Ibrahim</option>
                        <option value="Denaro Novanda Yogaswara">Denaro Novanda Yogaswara</option>
                        <option value="Dzakiy Abimanyu Bachtiar">Dzakiy Abimanyu Bachtiar</option>
                        <option value="Feni Handista Ayu Farini">Feni Handista Ayu Farini</option>
                        <option value="Griselda Savila H.">Griselda Savila H.</option>
                        <option value="Idris Abdurrahman">Idris Abdurrahman</option>
                        <option value="Ikmal Rifqi">Ikmal Rifqi</option>
                        <option value="Kaidzar Bagas Pradipta">Kaidzar Bagas Pradipta</option>
                        <option value="Mohammad Zidanil Izzat">Mohammad Zidanil Izzat</option>
                        <option value="Muhammad Alif">Muhammad Alif</option>
                        <option value="Muhammad Hisyam Wafi'i Putra">Muhammad Hisyam Wafi'i Putra</option>
                        <option value="Nadhim Aufa Hamdhani">Nadhim Aufa Hamdhani</option>
                        <option value="Narra Arhab P.">Narra Arhab P.</option>
                        <option value="Naufal Ryodha Pasyaan">Naufal Ryodha Pasyaan</option>
                        <option value="Naylatul Mutammimah">Naylatul Mutammimah</option>
                        <option value="Noni Niken Chelzianti">Noni Niken Chelzianti</option>
                        <option value="Surya Patrialis Dizgyanda">Surya Patrialis Dizgyanda</option>
                        <option value="Waldan Kiraman Lamani">Waldan Kiraman Lamani</option>
                        <option value="Zakiyyah Anwar Rahadatul Aisyi">Zakiyyah Anwar Rahadatul Aisyi</option>
                        <option value="Zhafira Sakhi Azkya">Zhafira Sakhi Azkya</option>
                        <option value="Zidny Elmann Nafiansyah">Zidny Elmann Nafiansyah</option>
                    </select>
                </div>
            </div>
            
            <div class="mb-8">
                <label class="block text-xs font-bold text-indigo-400 uppercase tracking-wider mb-3 text-center"><i class="fa-solid fa-palette mr-1"></i> Pilih Warna</label>
                <div class="grid grid-cols-2 gap-4">
                    <button onclick="selectAvatar('male', this)" class="avatar-btn py-4 px-3 bg-gray-950/90 border-[3px] border-cyan-400 rounded-2xl flex flex-col items-center justify-center hover:bg-gray-800 transition shadow-lg group btn-3d border-b-[6px] border-b-cyan-600 active:border-b-cyan-400">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-red-400 to-red-600 mb-2 shadow-[0_0_15px_rgba(239,68,68,0.9)] transform group-hover:scale-110 transition"></div>
                        <span class="text-sm font-display text-white font-bold tracking-wide">Bola Merah</span>
                    </button>
                    <button onclick="selectAvatar('female', this)" class="avatar-btn py-4 px-3 bg-gray-950/90 border-[3px] border-gray-800 rounded-2xl flex flex-col items-center justify-center hover:bg-gray-800 transition shadow-lg group btn-3d border-b-[6px] border-b-gray-900 active:border-b-gray-800">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-fuchsia-400 to-fuchsia-600 mb-2 shadow-[0_0_15px_rgba(217,70,239,0.9)] transform group-hover:scale-110 transition"></div>
                        <span class="text-sm font-display text-white font-bold tracking-wide">Bola Magenta</span>
                    </button>
                </div>
            </div>
            
            <button onclick="startGameFromLogin()" class="btn-3d w-full py-4 bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 text-white font-display font-bold rounded-2xl text-xl transition-all shadow-[0_0_30px_rgba(6,182,212,0.5)] border-b-[6px] border-indigo-800 hover:from-cyan-400 hover:to-indigo-500 tracking-wide uppercase"><i class="fa-solid fa-rocket mr-2"></i> Mulai Permainan</button>
            
            <p class="text-center text-indigo-300/70 text-sm font-bold mt-6 tracking-wide drop-shadow-md">Oleh: Vyke Triawilly Pradista, S.Pd.</p>
        </div>
    </div>

    <!-- HUD Overlay Terpusat & Rapi (Perbaikan Stretch Bug) -->
    <div id="hud" class="ui-layer hidden flex justify-center items-start p-2 sm:p-4">
        <div class="pointer-events-auto bg-slate-900/90 backdrop-blur-xl border-[3px] border-indigo-500/50 rounded-2xl p-3 sm:p-4 flex flex-col gap-3 w-full max-w-2xl shadow-[0_10px_40px_rgba(0,0,0,0.6)] mt-2 md:mt-4">
            <!-- Baris Atas: Identitas & Tombol -->
            <div class="flex justify-between items-center w-full">
                <div class="flex items-center gap-3">
                    <div id="hud-avatar" class="w-10 h-10 rounded-full bg-red-500 shadow-[0_0_10px_rgba(255,255,255,0.3)] border-2 border-white/50"></div>
                    <div class="flex flex-col">
                        <span id="hud-name" class="font-bold text-white text-sm sm:text-base tracking-wide leading-tight">Nama</span>
                        <span id="hud-level" class="font-display text-cyan-400 font-bold text-xs sm:text-sm tracking-widest uppercase mt-0.5">LEVEL 1</span>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button onclick="exportPDF()" class="interactive btn-3d px-3 py-2 sm:px-4 sm:py-2.5 bg-gradient-to-r from-cyan-600 to-blue-600 text-white font-bold rounded-xl text-xs sm:text-sm transition shadow-lg border-b-[4px] border-blue-800 hover:from-cyan-500 hover:to-blue-500 flex items-center space-x-2">
                        <i class="fa-solid fa-file-pdf"></i><span class="hidden sm:inline">Rekap PDF</span>
                    </button>
                    <button onclick="confirmReturnToLogin()" class="interactive btn-3d px-3 py-2 sm:px-4 sm:py-2.5 bg-gradient-to-r from-rose-600 to-red-600 text-white font-bold rounded-xl text-xs sm:text-sm transition shadow-lg border-b-[4px] border-red-800 hover:from-rose-500 hover:to-red-500 flex items-center space-x-2">
                        <i class="fa-solid fa-right-from-bracket"></i><span class="hidden sm:inline">Keluar</span>
                    </button>
                </div>
            </div>
            <!-- Baris Bawah: Statistik Poin, Soal, Nyawa -->
            <div class="flex justify-between items-center bg-slate-950/60 rounded-xl p-2 sm:p-3 border border-slate-700/50 shadow-inner">
                <div id="hud-lives" class="flex items-center text-sm sm:text-base"></div>
                <div class="text-indigo-300 font-bold text-xs sm:text-sm font-display tracking-wide text-center" id="hud-score">Skor: 0 | Total: 0</div>
                <div class="text-emerald-400 font-black text-xs sm:text-sm bg-emerald-900/40 px-2.5 py-1 rounded-lg inline-block text-center border border-emerald-500/30" id="hud-progress">Soal: 1/7</div>
            </div>
        </div>
    </div>

    <!-- Floating Text untuk Pengurangan Poin (Rintangan) -->
    <div id="damage-text" class="fixed top-[40%] left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-rose-500 font-display font-black text-6xl drop-shadow-[0_0_20px_rgba(244,63,94,0.8)] hidden pointer-events-none z-[60] tracking-widest uppercase" style="text-shadow: 3px 3px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;">
        -5 POIN!
    </div>

    <!-- 1. Quiz / Question Popup -->
    <div id="quiz-ui" class="absolute inset-0 bg-slate-950/90 backdrop-blur-xl z-40 hidden flex-col items-center justify-center interactive p-4 transition-all">
        <div class="animate-pop bg-gradient-to-b from-slate-900 via-gray-900 to-slate-950 p-6 md:p-8 rounded-3xl max-w-lg w-full border-[3px] border-cyan-400/80 shadow-[0_0_60px_rgba(6,182,212,0.45)] relative overflow-hidden">
            <!-- Ambient Glow Effects inside -->
            <div class="absolute -top-20 -left-20 w-40 h-40 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-20 -right-20 w-40 h-40 bg-purple-500/20 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="absolute -top-4 -right-4 bg-gradient-to-r from-red-600 to-rose-600 border-[3px] border-white/40 px-5 py-2 rounded-full shadow-[0_0_20px_rgba(239,68,68,0.7)] flex items-center justify-center space-x-2 z-10">
                <i class="fa-solid fa-heart text-red-100 text-sm fa-beat"></i>
                <span id="quiz-lives-display" class="text-white font-display font-bold text-xl">3</span>
            </div>

            <div class="text-center mb-6 relative z-10 mt-3">
                <span class="inline-block px-4 py-1.5 bg-cyan-500/20 border border-cyan-400/40 text-cyan-300 text-xs font-black rounded-full mb-4 tracking-widest uppercase shadow-[0_0_15px_rgba(6,182,212,0.3)]"><i class="fa-solid fa-bolt text-yellow-400 mr-1"></i> Ujian Kompetensi Math</span>
                <div class="bg-slate-950/80 backdrop-blur-md rounded-2xl p-6 min-h-[120px] flex items-center justify-center border-2 border-cyan-500/30 shadow-[inset_0_4px_15px_rgba(0,0,0,0.6)] relative">
                    <p id="question-text" class="text-base md:text-lg font-bold text-white text-center leading-relaxed"></p>
                </div>
            </div>
            
            <div id="quiz-options" class="grid grid-cols-1 gap-3 relative z-10"></div>

            <div id="wrong-actions" class="hidden flex-col items-center gap-4 mt-5 relative z-10">
                <div class="flex items-center space-x-3 text-rose-400 font-display font-bold text-xl bg-rose-950/50 px-6 py-3 rounded-2xl border border-rose-500/30">
                    <i class="fa-solid fa-circle-xmark fa-shake text-2xl"></i>
                    <span>JAWABAN KURANG TEPAT</span>
                </div>
                <button onclick="retryQuestion()" class="btn-3d w-full py-4 bg-gradient-to-r from-red-600 via-rose-600 to-pink-600 text-white font-display font-bold rounded-xl text-lg transition shadow-[0_0_25px_rgba(239,68,68,0.5)] border-b-[5px] border-red-900 hover:from-red-500 hover:to-pink-500 uppercase tracking-wide"><i class="fa-solid fa-rotate-right mr-2"></i> Coba Lagi (-1 Nyawa)</button>
                <button onclick="skipQuestion()" class="btn-3d w-full py-3.5 bg-slate-800 text-slate-300 font-bold rounded-xl text-sm transition border-2 border-slate-600 border-b-[4px] hover:bg-slate-700 hover:text-white"><i class="fa-solid fa-forward-step mr-2"></i> Lewati Soal (0 Poin)</button>
            </div>
        </div>
    </div>

    <!-- 2. Gift Box Popup -->
    <div id="gift-modal" class="absolute inset-0 bg-black/90 backdrop-blur-xl z-[100] hidden flex-col items-center justify-center interactive p-4">
        <div class="animate-pop bg-gradient-to-b from-gray-900 via-slate-900 to-gray-950 p-6 md:p-8 rounded-3xl border-[3px] border-amber-400 max-w-lg w-full text-center shadow-[0_0_80px_rgba(251,191,36,0.4)] relative overflow-hidden">
            <div class="absolute -top-16 -left-16 w-32 h-32 bg-amber-500/30 rounded-full blur-2xl pointer-events-none"></div>
            <div class="w-24 h-24 bg-gradient-to-tr from-amber-500/20 to-yellow-300/20 rounded-full flex items-center justify-center mx-auto mb-5 border-2 border-amber-400/70 shadow-[0_0_40px_rgba(251,191,36,0.5)]">
                <i id="gift-icon" class="fa-solid fa-gift fa-bounce text-5xl text-amber-400 drop-shadow-[0_0_15px_rgba(251,191,36,0.8)]"></i>
            </div>
            <h3 id="gift-header" class="font-display text-2xl md:text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-200 mb-2 uppercase tracking-wide">KOTAK HADIAH TERBUKA!</h3>
            <p id="gift-title" class="text-lg md:text-xl font-bold text-cyan-300 mb-5"></p>
            
            <div id="gift-content" class="bg-slate-950/90 p-5 rounded-2xl border-2 border-amber-500/30 mb-6 text-sm text-gray-200 text-left leading-relaxed max-h-60 overflow-y-auto shadow-[inset_0_2px_10px_rgba(0,0,0,0.8)]"></div>

            <button onclick="closeGiftModal()" class="btn-3d w-full py-4 bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 text-gray-950 font-display font-bold rounded-2xl transition shadow-[0_0_30px_rgba(251,191,36,0.6)] text-lg border-b-[5px] border-amber-600 hover:from-amber-300 hover:to-yellow-300 uppercase"><i class="fa-solid fa-hand-holding-heart mr-2"></i> Ambil Hadiah & Lanjut</button>
        </div>
    </div>

    <!-- 3. Generic Warning / Notification Popup -->
    <div id="msg-modal" class="absolute inset-0 bg-black/85 backdrop-blur-md z-[100] hidden flex-col items-center justify-center interactive p-4">
        <div class="animate-pop bg-gradient-to-b from-gray-900 via-slate-900 to-slate-950 p-6 md:p-8 rounded-3xl border-[3px] border-rose-500 max-w-sm w-full text-center shadow-[0_0_60px_rgba(244,63,94,0.4)] relative overflow-hidden">
            
            <!-- Tombol X untuk Batal -->
            <button id="msg-close-btn" onclick="cancelMsgModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white transition w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10 hidden bg-gray-800/50">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>

            <div class="w-16 h-16 bg-rose-500/20 rounded-full flex items-center justify-center mx-auto mb-4 border-2 border-rose-500/50 shadow-[0_0_30px_rgba(244,63,94,0.5)]">
                <i class="fa-solid fa-triangle-exclamation fa-beat-fade text-3xl text-rose-400"></i>
            </div>
            <h3 id="msg-title" class="font-display text-2xl font-bold text-white mb-3 tracking-wide"></h3>
            <p id="msg-body" class="text-gray-300 text-sm mb-7 whitespace-pre-line leading-relaxed font-semibold"></p>
            
            <div class="flex gap-3 w-full">
                <!-- Tombol Batal -->
                <button id="msg-cancel-btn" onclick="cancelMsgModal()" class="btn-3d hidden flex-1 py-3.5 bg-slate-800 text-white font-bold rounded-xl transition border-2 border-slate-600 border-b-[4px] hover:bg-slate-700 text-sm"><i class="fa-solid fa-ban mr-1"></i> Batal</button>
                <!-- Tombol Konfirmasi -->
                <button id="msg-confirm-btn" onclick="closeMsgModal()" class="btn-3d flex-1 py-3.5 bg-gradient-to-r from-rose-600 via-red-600 to-pink-600 text-white font-bold rounded-xl transition shadow-[0_0_20px_rgba(244,63,94,0.6)] border-b-[4px] border-red-900 hover:from-rose-500 hover:to-pink-500 text-sm"></button>
            </div>
        </div>
    </div>

    <!-- 4. Game Over Popup -->
    <div id="game-over" class="absolute inset-0 bg-slate-950/95 backdrop-blur-2xl z-50 hidden flex-col items-center justify-center interactive p-4 text-center">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(239,68,68,0.25)_0,transparent_75%)] pointer-events-none"></div>
        <div class="animate-pop relative z-10 max-w-md w-full bg-slate-900/90 border-[3px] border-red-500/80 rounded-3xl p-8 shadow-[0_0_80px_rgba(239,68,68,0.5)]">
            <div class="w-24 h-24 bg-red-500/20 rounded-full flex items-center justify-center mx-auto mb-5 border-2 border-red-500/50 shadow-[0_0_40px_rgba(239,68,68,0.6)]">
                <i class="fa-solid fa-skull fa-shake text-5xl text-red-500 drop-shadow-lg"></i>
            </div>
            <h2 class="font-display text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-400 to-pink-500 mb-3 drop-shadow-[0_0_20px_rgba(220,38,38,0.8)] tracking-wide uppercase">PERMAINAN USAI</h2>
            <p id="go-reason" class="text-sm md:text-base text-gray-300 mb-8 font-bold leading-relaxed bg-black/40 p-4 rounded-xl border border-red-900/50"></p>
            <button onclick="returnToLogin()" class="btn-3d w-full py-4 bg-gradient-to-r from-indigo-600 via-blue-600 to-cyan-600 text-white font-display font-bold rounded-2xl text-lg transition shadow-[0_0_30px_rgba(99,102,241,0.6)] border-b-[5px] border-indigo-900 hover:from-indigo-500 hover:to-cyan-500 uppercase"><i class="fa-solid fa-house mr-2"></i> Kembali ke Login</button>
        </div>
    </div>

    <!-- 5. Level Recap / Summary Popup -->
    <div id="level-recap" class="absolute inset-0 bg-slate-950/95 backdrop-blur-2xl z-50 hidden flex-col items-center justify-center interactive p-4 text-center">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(52,211,153,0.2)_0,transparent_75%)] pointer-events-none"></div>
        <div class="animate-pop relative z-10 max-w-xl w-full">
            <h2 id="recap-title" class="font-display text-4xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-cyan-400 mb-6 drop-shadow-[0_0_20px_rgba(52,211,153,0.6)] tracking-wide"><i class="fa-solid fa-trophy mr-3 text-yellow-400"></i>LEVEL SELESAI</h2>
            
            <div class="bg-slate-900/90 backdrop-blur-xl p-6 md:p-8 rounded-3xl border-[3px] border-emerald-500/50 text-center mb-8 shadow-[0_0_60px_rgba(16,185,129,0.3)] w-full relative overflow-hidden">
                <div class="absolute -top-12 -right-12 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl"></div>
                <p class="text-gray-400 text-xs md:text-sm uppercase tracking-widest mb-1 font-bold">Jumlah Soal Benar</p>
