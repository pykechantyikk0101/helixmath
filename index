        function computeCurrentLevelScore() {
            let totalQ = currentLevelQuestions.length || 1;
            let baseScore = Math.round((correctAnswersCount / totalQ) * 100);
            let finalScore = baseScore - levelPenalty;
            // Menghilangkan batasan (clamping) 0 agar skor bisa bernilai negatif (minus) saat belum ada skor tapi kena duri
            return finalScore;
        }

        function computeOverallTotalScore() {
            let sum = 0;
            for (let lvl = 1; lvl <= 4; lvl++) {
                if (lvl === currentLevel && (gameState === "PLAYING" || gameState === "QUIZ" || gameState === "GIFT_MODAL")) {
                    let ongoing = computeCurrentLevelScore();
                    if (levelScoresHistory[lvl] !== null) {
                        // Mempertahankan visual akumulasi menggunakan skor tertinggi yang tersimpan
                        sum += Math.max(ongoing, levelScoresHistory[lvl].score);
                    } else {
                        sum += ongoing;
                    }
                } else if (levelScoresHistory[lvl] !== null) {
                    sum += levelScoresHistory[lvl].score;
                }
            }
            return sum;
        }

