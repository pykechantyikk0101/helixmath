                questions: [
                    { q: "Manakah di bawah ini yang merupakan persamaan kuadrat?", options: ["\\( 2x + 5 = 0 \\)", "\\( x^2 + 3x - 4 = 0 \\)", "\\( x^3 - 2x = 0 \\)", "\\( x^{\\frac{1}{2}} + 2 = 0 \\)"], answer: "\\( x^2 + 3x - 4 = 0 \\)" },
                    { q: "Manakah di bawah ini yang BUKAN persamaan kuadrat?", options: ["\\( x^2 - 9 = 0 \\)", "\\( 3x^2 + x = 0 \\)", "\\( 2x - 7 = 0 \\)", "\\( x^2 = 16 \\)"], answer: "\\( 2x - 7 = 0 \\)" },
                    { q: "Di antara persamaan berikut, yang merupakan persamaan kuadrat adalah...", options: ["\\( 5x + 2 = 3x - 1 \\)", "\\( x^2 + 2x + 1 = 0 \\)", "\\( 2x^3 - x^2 = 0 \\)", "\\( \\sqrt{x} + 1 = 0 \\)"], answer: "\\( x^2 + 2x + 1 = 0 \\)" },
                    { q: "Persamaan berikut yang bukan persamaan kuadrat adalah...", options: ["\\( x^2 - 5x + 6 = 0 \\)", "\\( 4x^2 = 9 \\)", "\\( x(x - 3) = 0 \\)", "\\( 3x + 4 = 10 \\)"], answer: "\\( 3x + 4 = 10 \\)" },
                    { q: "Manakah di bawah ini yang merupakan persamaan kuadrat?", options: ["\\( x^{\\frac{3}{2}} + 2x = 0 \\)", "\\( x^{-2} + x = 1 \\)", "\\( x^2 - 4x + 3 = 0 \\)", "\\( \\frac{2}{x} + x = 5 \\)"], answer: "\\( x^2 - 4x + 3 = 0 \\)" },
                    { q: "Manakah di bawah ini yang BUKAN persamaan kuadrat?", options: ["\\( x^2 + x - 12 = 0 \\)", "\\( 5x^2 = 20 \\)", "\\( x^{\\frac{1}{2}} - 3 = 0 \\)", "\\( (x - 2)(x + 5) = 0 \\)"], answer: "\\( x^{\\frac{1}{2}} - 3 = 0 \\)" },
                    { q: "Manakah di bawah ini yang merupakan persamaan kuadrat?", options: ["\\( (x - 1)^2 = x^2 + 2x \\)", "\\( x^2 + \\frac{1}{x} = 4 \\)", "\\( (x + 2)(x - 3) = 0 \\)", "\\( 2^{x} + x = 0 \\)"], answer: "\\( (x + 2)(x - 3) = 0 \\)" }
                ]
            },
            2: {
                title: "Menentukan Nilai Koefisien a, b, c",
                hintText: "<strong>💡 Petunjuk Level 2:</strong><br>Susun ke bentuk baku \\( ax^2 + bx + c = 0 \\).<br>• \\( a \\) = koefisien \\( x^2 \\)<br>• \\( b \\) = koefisien \\( x \\)<br>• \\( c \\) = konstanta.",
                questions: [
                    { q: "Dari persamaan \\( 2x^2 + 5x - 3 = 0 \\), nilai \\(a\\), \\(b\\), dan \\(c\\) berturut-turut adalah...", options: ["2, 5, -3", "2, -5, 3", "-2, 5, 3", "2, 5, 3"], answer: "2, 5, -3" },
                    { q: "Dari persamaan \\( x^2 - 7x + 10 = 0 \\), nilai \\(a + b + c\\) adalah...", options: ["4", "2", "-4", "18"], answer: "4" },
                    { q: "Dari persamaan \\( 3x - 6 + x^2 = 0 \\), nilai \\(a\\), \\(b\\), dan \\(c\\) berturut-turut adalah...", options: ["1, 3, -6", "1, -3, 6", "3, 1, -6", "1, 3, 6"], answer: "1, 3, -6" },
                    { q: "Dari persamaan \\( \\frac{1}{2}x^2 - 4x + 6 = 0 \\), nilai \\(a\\), \\(b\\), dan \\(c\\) berturut-turut adalah...", options: ["\\(\\frac{1}{2}\\), -4, 6", "\\(\\frac{1}{2}\\), 4, 6", "1, -8, 12", "2, -4, 6"], answer: "\\(\\frac{1}{2}\\), -4, 6" },
                    { q: "Dari persamaan \\( 5 - 2x^2 + x = 0 \\), nilai \\(a\\), \\(b\\), dan \\(c\\) berturut-turut adalah...", options: ["-2, 1, 5", "2, 1, 5", "-2, -1, 5", "2, -1, -5"], answer: "-2, 1, 5" },
                    { q: "Dari persamaan \\( \\frac{x^2}{3} - \\frac{2x}{5} + 1 = 0 \\), nilai \\(a\\), \\(b\\), dan \\(c\\) berturut-turut adalah...", options: ["\\(\\frac{1}{3}\\), \\(-\\frac{2}{5}\\), 1", "\\(\\frac{1}{3}\\), \\(\\frac{2}{5}\\), 1", "1, -2, 1", "3, 5, 1"], answer: "\\(\\frac{1}{3}\\), \\(-\\frac{2}{5}\\), 1" },
                    { q: "Dari persamaan \\( \\frac{x^2 - 4}{2} + \\frac{x}{3} = 1 \\), nilai \\(a\\), \\(b\\), dan \\(c\\) berturut-turut adalah...", options: ["3, 2, -18", "1, 2, -6", "3, 2, -6", "6, 4, -12"], answer: "3, 2, -18" }
                ]
            },
            3: {
                title: "Menentukan Nilai Diskriminan D = b² - 4ac",
                hintText: "<strong>💡 Petunjuk Level 3:</strong><br>Gunakan rumus Diskriminan: \\( D = b^2 - 4ac \\).<br>• Jika \\( D > 0 \\): 2 akar real berbeda<br>• Jika \\( D = 0 \\): 2 akar kembar/sama<br>• Jika \\( D < 0 \\): tidak ada akar real.",
                questions: [
                    { q: "Diskriminan dari persamaan \\( x^2 + 4x + 3 = 0 \\) adalah...", options: ["4", "8", "16", "28"], answer: "4" },
