        function applyLevelTheme(lvl) {
            const theme = levelThemes[lvl] || levelThemes[1];
            const canvasContainer = document.getElementById('game-canvas');
            if (canvasContainer) {
                canvasContainer.style.background = `linear-gradient(to bottom, ${theme.bgTop}, ${theme.bgBottom})`;
            }
            if (scene) {
                scene.background = null;
                scene.fog = new THREE.Fog(new THREE.Color(theme.bgBottom), 15, 30);
            }
        }

        function createPlatform(y, type, giftNumber = 1) {
            const group = new THREE.Group();
            group.position.y = y;
            const theme = levelThemes[currentLevel] || levelThemes[1];
            
            if (type === 'QUESTION') {
                const material = new THREE.MeshPhongMaterial({ 
                    color: theme.specialPlatform, 
                    emissive: theme.specialPlatform,
                    emissiveIntensity: 0.5,
                    flatShading: true 
                });
                const geom = new THREE.CylinderGeometry(3.5, 3.5, PLATFORM_THICKNESS, 32);
                const mesh = new THREE.Mesh(geom, material);
                group.add(mesh);

                const ringGeom = new THREE.TorusGeometry(3.2, 0.18, 16, 32);
                const ringMat = new THREE.MeshPhongMaterial({ color: 0xFFFFFF, emissive: 0xFFFFFF, emissiveIntensity: 0.9 });
                const ring = new THREE.Mesh(ringGeom, ringMat);
                ring.rotation.x = Math.PI / 2;
                ring.position.y = PLATFORM_THICKNESS / 2 + 0.05;
                group.add(ring);

                for(let i=0; i<6; i++) {
                    let angle = (i / 6) * Math.PI * 2;
                    let dotGeom = new THREE.BoxGeometry(0.3, 0.1, 0.3);
                    let dotMat = new THREE.MeshPhongMaterial({ color: 0x030712 });
                    let dot = new THREE.Mesh(dotGeom, dotMat);
                    dot.position.set(Math.cos(angle)*2.4, PLATFORM_THICKNESS / 2 + 0.08, Math.sin(angle)*2.4);
                    group.add(dot);
                }

                group.userData = { isSpecial: true, isGift: false, active: true };
            } 
            else if (type === 'GIFT') {
                const thetaLength = Math.PI * 2 - GAP_ANGLE;
                const thetaStart = Math.random() * Math.PI * 2;

                const material = new THREE.MeshPhongMaterial({ color: theme.platform, flatShading: true });
                const geom = new THREE.CylinderGeometry(3.5, 3.5, PLATFORM_THICKNESS, 32, 1, false, thetaStart, thetaLength);
                const mesh = new THREE.Mesh(geom, material);
                group.add(mesh);

                // Buat Pivot (Poros Putar) untuk mengorbitkan Hadiah
                const pivot = new THREE.Group();
                pivot.position.y = PLATFORM_THICKNESS / 2 + 0.5;

                const boxGroup = new THREE.Group();
                const boxGeom = new THREE.BoxGeometry(0.8, 0.8, 0.8);
                const boxColor = giftNumber === 1 ? 0xFBBF24 : 0x38BDF8;
                const boxMat = new THREE.MeshPhongMaterial({ color: boxColor, emissive: boxColor, emissiveIntensity: 0.5 });
                const giftMesh = new THREE.Mesh(boxGeom, boxMat);

                const ribbonGeom = new THREE.BoxGeometry(0.85, 0.85, 0.2);
                const ribbonMat = new THREE.MeshPhongMaterial({ color: 0xEF4444, emissive: 0xDC2626 });
                const ribbon = new THREE.Mesh(ribbonGeom, ribbonMat);
                boxGroup.add(giftMesh);
                boxGroup.add(ribbon);

                // Geser Box sejauh Radius agar tidak berada di tengah poros tiang
                const boxRadius = 2.4;
                boxGroup.position.set(boxRadius, 0, 0); 
                
                // Masukkan Box ke Pivot
                pivot.add(boxGroup);
                
                // Rotasi awal Pivot acak
                pivot.rotation.y = Math.random() * Math.PI * 2;
                group.add(pivot);

                let gapStart = thetaStart + thetaLength + 0.15;
                let gapEnd = thetaStart + Math.PI * 2 - 0.15;

                group.userData = { 
                    isSpecial: false, 
                    isGift: true,
                    giftNumber: giftNumber,
                    giftPivot: pivot, // Simpan referensi pivot untuk animasi orbit
                    giftBob: boxGroup, // Simpan referensi box untuk animasi melayang
                    giftMesh: giftMesh, // Target kolisi
                    giftActive: true,
                    gapStart: gapStart, 
                    gapEnd: gapEnd, 
                    active: true 
                };
            }
            else if (type === 'OBSTACLE') {
                const material = new THREE.MeshPhongMaterial({ color: theme.platform, flatShading: true });
                const thetaLength = Math.PI * 2 - GAP_ANGLE;
                const thetaStart = Math.random() * Math.PI * 2;
                
                const geom = new THREE.CylinderGeometry(3.5, 3.5, PLATFORM_THICKNESS, 32, 1, false, thetaStart, thetaLength);
                const mesh = new THREE.Mesh(geom, material);
                group.add(mesh);

                // Tambahkan Rintangan Duri Merah
                const margin = 0.5;
                const spikeAngle = thetaStart + margin + Math.random() * (thetaLength - margin * 2);
                
                const spikeGeom = new THREE.ConeGeometry(0.5, 0.8, 16);
                const spikeMat = new THREE.MeshPhongMaterial({ color: 0xEF4444, emissive: 0x990000 });
                const spike = new THREE.Mesh(spikeGeom, spikeMat);
                
                const radius = 2.0;
                spike.position.set(
                    Math.sin(spikeAngle) * radius,
                    PLATFORM_THICKNESS / 2 + 0.4,
                    Math.cos(spikeAngle) * radius
                );
                group.add(spike);
                
                let gapStart = thetaStart + thetaLength + 0.15;
                let gapEnd = thetaStart + Math.PI * 2 - 0.15;
                
                group.userData = { 
                    isSpecial: false, 
                    isGift: false,
                    isObstacle: true,
                    obstacleActive: true,
                    obstacleMesh: spike,
                    gapStart: gapStart, 
                    gapEnd: gapEnd, 
                    active: true 
                };
            }
            else {
                const material = new THREE.MeshPhongMaterial({ color: theme.platform, flatShading: true });
                const thetaLength = Math.PI * 2 - GAP_ANGLE;
                const thetaStart = Math.random() * Math.PI * 2;
                
                const geom = new THREE.CylinderGeometry(3.5, 3.5, PLATFORM_THICKNESS, 32, 1, false, thetaStart, thetaLength);
                const mesh = new THREE.Mesh(geom, material);
                group.add(mesh);

                // PENYELESAIAN BUG & ACAK POSISI STRIPE
                // Kalkulasi angle acak di dalam bagian papan yang solid (berjarak aman dari tepi bolongan)
                const margin = 0.4;
                const randomAngle = thetaStart + margin + Math.random() * (thetaLength - margin * 2);
                
                const stripeGeom = new THREE.BoxGeometry(0.2, 0.05, 2.8);
                const stripeMat = new THREE.MeshPhongMaterial({ color: 0xFFFFFF, emissive: 0x444444 });
                let stripe = new THREE.Mesh(stripeGeom, stripeMat);
                
                // Posisikan menggunakan koordinat trigonometri lingkaran (r=1.8) berdasarkan randomAngle
                // Three.js CylinderGeometry orientasi default dimulai pada Z+ menyapu ke arah X+
                const radius = 1.8;
                stripe.position.set(
                    Math.sin(randomAngle) * radius,
                    PLATFORM_THICKNESS / 2 + 0.03,
                    Math.cos(randomAngle) * radius
                );
                // Putar stripe (kotak panjang) agar sejajar dengan titik pusat silinder
                stripe.rotation.y = randomAngle;
                group.add(stripe);
                
                let gapStart = thetaStart + thetaLength + 0.15;
                let gapEnd = thetaStart + Math.PI * 2 - 0.15;
                
                group.userData = { 
                    isSpecial: false, 
                    isGift: false,
                    gapStart: gapStart, 
                    gapEnd: gapEnd, 
                    active: true 
                };
            }
            return group;
        }

        function generateLevel(levelNumber) {
            applyLevelTheme(levelNumber);
            prepareLevelQuestions(levelNumber);
            
            while(towerGroup.children.length > 0) {
                towerGroup.remove(towerGroup.children[0]);
            }
            platforms = [];
            specialPlatforms = [];
            
            ball.position.set(0, 0, 2.6);
            ballVy = 0;
            towerGroup.rotation.y = 0;

            let yPos = -4;
            let spacing = 4;

            const totalQCount = currentLevelQuestions.length;
            let currentGiftCount = 0;
            
            for (let q = 0; q < totalQCount; q++) {
                // Diubah menjadi tepat 15 papan per seksi soal untuk memastikan akurasi penempatan duri
                let sectionLength = 15; 
                let giftPlacedInSection = false;
                let giftIndexPos = Math.floor(sectionLength / 2);

                for (let i = 0; i < sectionLength; i++) {
                    let type = 'NORMAL';
                    let giftNum = 1;
                    
                    if ((q === 0 || q === Math.floor(totalQCount / 2)) && !giftPlacedInSection && i === giftIndexPos && currentGiftCount < 2) {
                        type = 'GIFT';
                        currentGiftCount++;
                        giftNum = currentGiftCount;
                        giftPlacedInSection = true;
                    } 
                    // Penempatan Duri: PASTI di papan ke-5 (index 4) dan ke-12 (index 11) setelah papan soal sebelumnya
                    else if (i === 4 || i === 11) {
                        type = 'OBSTACLE';
                    }

                    let p = createPlatform(yPos, type, giftNum);
                    towerGroup.add(p);
                    platforms.push(p);
                    yPos -= spacing;
                }
                
                let sp = createPlatform(yPos, 'QUESTION');
                towerGroup.add(sp);
                platforms.push(sp);
                specialPlatforms.push(sp);
                yPos -= spacing;
            }

            // Papan menuju Finish (tanpa duri)
            let finishSectionLength = 3;
            for (let i = 0; i < finishSectionLength; i++) {
                let p = createPlatform(yPos, 'NORMAL');
                towerGroup.add(p);
                platforms.push(p);
                yPos -= spacing;
            }

            let fp = createPlatform(yPos, 'QUESTION');
            fp.userData.isFinish = true;
            fp.children[0].material.color.setHex(0x22C55E);
            towerGroup.add(fp);
            platforms.push(fp);

            const totalHeight = Math.abs(yPos) + 10;
            const theme = levelThemes[levelNumber] || levelThemes[1];
            const pillarGeom = new THREE.CylinderGeometry(0.8, 0.8, totalHeight, 32);
            const pillarMat = new THREE.MeshPhongMaterial({ color: theme.pillar });
            const pillar = new THREE.Mesh(pillarGeom, pillarMat);
            pillar.position.y = -totalHeight / 2 + 2;
            towerGroup.add(pillar);
        }

        function setupControls() {
            let isDragging = false;
            let previousX = 0;
            
            const handleStart = (x) => { if(gameState === "PLAYING") { isDragging = true; previousX = x; } };
            const handleMove = (x) => {
                if (!isDragging || gameState !== "PLAYING") return;
                const deltaX = x - previousX;
                towerGroup.rotation.y += deltaX * 0.015;
                previousX = x;
            };
            const handleEnd = () => { isDragging = false; };

            document.addEventListener('mousedown', e => handleStart(e.clientX));
            document.addEventListener('mousemove', e => handleMove(e.clientX));
            document.addEventListener('mouseup', handleEnd);
            
            document.addEventListener('touchstart', e => handleStart(e.touches[0].clientX), {passive: false});
            document.addEventListener('touchmove', e => { handleMove(e.touches[0].clientX); e.preventDefault(); }, {passive: false});
            document.addEventListener('touchend', handleEnd);
        }

        function isAngleBetween(target, start, end) {
            target = (target % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
            start = (start % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
            end = (end % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
            
            if (start <= end) {
                return target >= start && target <= end;
            } else {
                return target >= start || target <= end;
            }
        }

        function updatePhysics() {
            let prevY = ball.position.y;
            ballVy -= GRAVITY;
            
            if (ballVy < -0.75) ballVy = -0.75; 
            ball.position.y += ballVy;

            platforms.forEach(p => {
                if (p.userData.isGift && p.userData.giftActive && p.userData.giftMesh) {
                    if (!tempBoxPos) tempBoxPos = new THREE.Vector3();
                    p.userData.giftMesh.getWorldPosition(tempBoxPos);
                    let distance = ball.position.distanceTo(tempBoxPos);

                    if (distance < 1.3) {
                        p.userData.giftActive = false;
                        p.userData.giftMesh.visible = false;
                        triggerGiftBox(p.userData.giftNumber || 1);
                    }
                }

                // Cek Tabrakan dengan Rintangan Duri Merah
                if (p.userData.isObstacle && p.userData.obstacleActive && p.userData.obstacleMesh) {
                    if (!tempBoxPos) tempBoxPos = new THREE.Vector3();
                    p.userData.obstacleMesh.getWorldPosition(tempBoxPos);
                    let distance = ball.position.distanceTo(tempBoxPos);

                    if (distance < 1.2) {
                        p.userData.obstacleActive = false;
                        p.userData.obstacleMesh.material.color.setHex(0x64748b); // Berubah abu-abu
                        p.userData.obstacleMesh.material.emissive.setHex(0x334155);
                        levelPenalty += 5; // Pengurangan 5 poin
                        playSound('wrong');
                        showDamageFloatText(); // Munculkan text animasi -5
                        updateHUD();
                    }
                }
            });

            if (ballVy < 0) {
                for (let p of platforms) {
                    if (!p.userData.active) continue;
                    
                    let platformTopY = p.position.y + PLATFORM_THICKNESS / 2;
                    
                    if (prevY - BALL_RADIUS >= platformTopY && ball.position.y - BALL_RADIUS <= platformTopY) {
                        
                        if (p.userData.isFinish) {
                            playSound('bounce');
                            handleLevelComplete();
                            ballVy = BOUNCE_VELOCITY;
                            ball.position.y = platformTopY + BALL_RADIUS;
                            break;
                        }
                        
                        if (p.userData.isSpecial) {
                            playSound('bounce');
                            ballVy = BOUNCE_VELOCITY;
                            ball.position.y = platformTopY + BALL_RADIUS;
                            currentSpecialPlatform = p;
                            showQuizUI();
                            break;
                        } else {
                            let localAngle = (-towerGroup.rotation.y) % (Math.PI * 2);
                            let inGap = isAngleBetween(localAngle, p.userData.gapStart, p.userData.gapEnd);
                            
                            if (inGap) {
                                playSound('break');
                                p.userData.active = false;
                                updateHUD();
                            } else {
                                playSound('bounce');
                                ballVy = BOUNCE_VELOCITY;
                                ball.position.y = platformTopY + BALL_RADIUS;
                                break;
                            }
                        }
                    }
                }
            }
        }

        let smoothCamY = 0;

        function animateLoop() {
            requestAnimationFrame(animateLoop);
            
            const time = Date.now() * 0.002; // Waktu untuk fungsi sinus melayang

            if (gameState === "PLAYING") {
                updatePhysics();
            }
            
            // Animasi untuk elemen khusus di menara
            platforms.forEach(p => {
                if (p.userData.isGift && p.userData.giftActive) {
                    if (p.userData.giftPivot) {
                        p.userData.giftPivot.rotation.y += 0.012; // Efek mengorbit / berputar mengelilingi menara
                    }
                    if (p.userData.giftBob) {
                        p.userData.giftBob.position.y = Math.sin(time + p.position.y) * 0.35; // Efek melayang naik turun
                        p.userData.giftBob.rotation.x += 0.01; // Putar kotaknya sendiri
                        p.userData.giftBob.rotation.y += 0.02;
                    }
                }
            });

            if (camera && ball) {
                let targetCamY = ball.position.y + 3.5;
                smoothCamY += (targetCamY - smoothCamY) * 0.12;
                
                camera.position.y = smoothCamY;
                camera.position.x = 0;
                camera.position.z = 10;
                camera.lookAt(0, smoothCamY - 3.5, 0);
            }
            
            if (renderer && scene && camera) {
                renderer.render(scene, camera);
            }
        }

        function startLevel(lvl) {
            currentLevel = lvl;
            lives = 3;
            cheatCount = 0;
            
            // Hanya mereset statistik untuk level yang berjalan saat ini
            correctAnswersCount = 0;
            incorrectAnswersCount = 0;
            questionIndex = 0;
            levelPenalty = 0; // Reset penalti rintangan
            
            generateLevel(lvl);
            smoothCamY = ball.position.y + 3.5;
            updateHUD();
            gameState = "PLAYING";
        }

        function handleLevelComplete() {
            gameState = "LEVEL_COMPLETE";
            const totalQ = currentLevelQuestions.length;
            const finalLvlScore = computeCurrentLevelScore();
            
            // Logika Penyimpanan SKOR TERTINGGI (Highest Score Retention)
            let prevData = levelScoresHistory[currentLevel];
            let prevBest = prevData !== null ? prevData.score : -999;
            let isPassed = correctAnswersCount >= (totalQ - ((currentLevel === 1 || currentLevel === 2) ? 2 : 1));

            // Hanya timpa data/histori jika skor kali ini lebih besar, atau sebelumnya belum pernah lulus
            if (!prevData || finalLvlScore > prevBest || (!isPassed && prevData === null)) {
                levelScoresHistory[currentLevel] = { 
                    score: finalLvlScore, 
                    correct: correctAnswersCount, 
                    incorrect: incorrectAnswersCount 
                };
            }

            document.getElementById('level-recap').classList.remove('hidden');
            document.getElementById('level-recap').style.display = "flex";
            
            let percentage = Math.min((correctAnswersCount / totalQ) * 100, 100);
            setTimeout(() => {
                document.getElementById('recap-bar').style.width = `${percentage}%`;
            }, 100);
            
            document.getElementById('recap-correct').innerText = correctAnswersCount;
            document.getElementById('recap-total-questions').innerText = ` / ${totalQ}`;
            
            // Info skor pada UI - Beritahu jika skor yang diambil adalah skor sebelumnya
            if (prevData !== null && prevBest > finalLvlScore) {
                document.getElementById('recap-level-score').innerHTML = `${finalLvlScore} <span class="text-xs text-amber-300 ml-1 block sm:inline">(Tetap pakai skor tertinggi: ${prevBest})</span>`;
            } else {
                document.getElementById('recap-level-score').innerText = `${finalLvlScore}`;
            }
            
            const statusEl = document.getElementById('recap-status');
            const btnNext = document.getElementById('btn-next-level');
            const btnRetry = document.getElementById('btn-retry-level');
            const btnDownload = document.getElementById('btn-download-pdf');
            const btnLogin = document.getElementById('btn-back-login');
            const titleEl = document.getElementById('recap-title');
            const finalCongratsEl = document.getElementById('recap-final-congrats');
            
            let maxAllowedWrong = (currentLevel === 1 || currentLevel === 2) ? 2 : 1;
            let minCorrectRequired = totalQ - maxAllowedWrong;
            
            document.getElementById('recap-req-text').innerText = `(Syarat lulus Level ${currentLevel}: Minimal benar ${minCorrectRequired} dari ${totalQ} soal)`;

            btnNext.classList.add('hidden');
            if (btnRetry) btnRetry.classList.add('hidden');
            if (btnDownload) btnDownload.classList.add('hidden');
            if (finalCongratsEl) finalCongratsEl.classList.add('hidden');
            // Sembunyikan tombol kembali ke menu utama secara default
            if (btnLogin) btnLogin.classList.add('hidden');

            if (correctAnswersCount >= minCorrectRequired) {
                statusEl.innerText = "LULUS";
                statusEl.className = "font-bold text-emerald-400";
                
                if (currentLevel < 4) {
                    btnNext.classList.remove('hidden');
                } else {
                    titleEl.innerText = "MENARA BERHASIL DIHANCURKAN";
                    titleEl.className = "text-2xl md:text-4xl font-black text-cyan-400 mb-6 drop-shadow-[0_0_15px_rgba(6,182,212,0.8)] tracking-wide";
                    if (btnDownload) btnDownload.classList.remove('hidden');
                    // Munculkan tombol Menu Utama HANYA saat lulus Level 4
                    if (btnLogin) btnLogin.classList.remove('hidden');
                    if (finalCongratsEl) {
                        finalCongratsEl.innerHTML = "Selamat atas keberhasilanmu! Seluruh kuis telah selesai kamu kerjakan dengan sangat baik.<br><br>⚠️ <strong>Pengingat Penting:</strong> Jangan lupa untuk segera mengunduh dan mengirimkan file PDF hasil skormu kepada guru agar nilaimu bisa langsung didata.";
                        finalCongratsEl.classList.remove('hidden');
                    }
                }

                // Tampilkan tombol "Perbaiki Skor" khusus untuk yang lulus tapi nilai < 80
                // atau jika total skor tertinggi yang tersimpan (prevBest) masih < 80
                let bestKnownScore = Math.max(finalLvlScore, prevBest);
                if (bestKnownScore <= 79 && btnRetry) {
                    btnRetry.classList.remove('hidden');
                    btnRetry.innerHTML = '<i class="fa-solid fa-arrow-rotate-right mr-2"></i> Perbaiki Skor';
                }

            } else {
                statusEl.innerText = `GAGAL (Hanya benar ${correctAnswersCount} dari batas min. ${minCorrectRequired} soal)`;
                statusEl.className = "font-bold text-red-500";
                
                // JIKA GAGAL: Hanya tampilkan tombol Ulangi (Tombol Lanjut, Unduh & Menu Utama disembunyikan)
                if (btnRetry) {
                    btnRetry.classList.remove('hidden');
                    btnRetry.innerHTML = '<i class="fa-solid fa-arrow-rotate-right mr-2"></i> Ulangi Level Ini';
                }
            }
        }

        function nextLevel() {
            document.getElementById('level-recap').classList.add('hidden');
            if (currentLevel < 4) {
                startLevel(currentLevel + 1);
            }
        }

        function restartLevel() {
            // Sembunyikan UI popup yang mungkin terbuka
            document.getElementById('level-recap').classList.add('hidden');
            document.getElementById('game-over').classList.add('hidden');
            document.getElementById('msg-modal').classList.add('hidden');
            document.getElementById('quiz-ui').classList.add('hidden');
            
            // PENTING: Jangan lagi mereset levelScoresHistory[currentLevel] di sini!
            // Sistem kini mempertahankan nilai histori demi fitur "Highest Score Retention"
            
            // Mengulang level yang sama
            startLevel(currentLevel);
        }

        function confirmReturnToLogin() {
            // Popup peringatan yang bisa di cancel (memiliki tombol X dan BATAL)
            showWarningModal(
                "KEMBALI KE LOGIN?", 
                "Apakah Anda yakin ingin keluar ke halaman login?\n\nPERINGATAN: Semua progres permainan akan dihapus dan Anda harus mengulang dari awal (Level 1).", 
                () => {
                    returnToLogin(); // Eksekusi jika menekan Ya
                },
                true // isCancellable = true
            );
        }

        function returnToLogin() {
            document.getElementById('level-recap').classList.add('hidden');
            document.getElementById('quiz-ui').classList.add('hidden');
            document.getElementById('gift-modal').classList.add('hidden');
            document.getElementById('game-over').classList.add('hidden');
            document.getElementById('msg-modal').classList.add('hidden');
            document.getElementById('hud').classList.add('hidden');
            document.getElementById('login-screen').classList.remove('hidden');
            
            const selectEl = document.getElementById('player-name');
            if (selectEl) selectEl.selectedIndex = 0;
            
            gameState = "LOGIN";
            currentLevel = 1;
            correctAnswersCount = 0;
            incorrectAnswersCount = 0;
            lives = 3;
            cheatCount = 0;
            
            // Jika benar-benar kembali ke login, maka total skor dihapus sepenuhnya
            levelScoresHistory = { 
                1: null, 
                2: null, 
                3: null, 
                4: null 
            };
        }

        function gameOver(reasonText) {
            gameState = "GAME_OVER";
            document.getElementById('go-reason').innerText = reasonText;
            document.getElementById('game-over').classList.remove('hidden');
            document.getElementById('game-over').style.display = "flex";
        }

        function exportPDF() {
            try {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();
                
                let studentName = playerData.name || "Siswa (Belum Login)";
                const dateStr = new Date().toLocaleString('id-ID');
                
                doc.setFillColor(15, 23, 42);
                doc.rect(0, 0, 210, 40, "F");
                
                doc.setFont("helvetica", "bold");
                doc.setFontSize(16);
                doc.setTextColor(255, 255, 255);
                doc.text("REKAPITULASI HASIL BELAJAR: EQUATIONS JUMP", 105, 18, { align: "center" });
                
                doc.setFontSize(10);
                doc.setTextColor(148, 163, 184);
                doc.text("Game Edukasi Matematika SMA Kelas X - Labyrinth Tower", 105, 27, { align: "center" });
                
                doc.setFillColor(241, 245, 249);
                doc.roundedRect(15, 48, 180, 20, 3, 3, "F");
                
                doc.setFont("helvetica", "bold");
                doc.setFontSize(10);
                doc.setTextColor(30, 41, 59);
                doc.text(`Nama Siswa : ${studentName}`, 22, 60);
                doc.text(`Tanggal       : ${dateStr}`, 120, 60);
                
                let startY = 78;
                doc.setFillColor(6, 182, 212);
                doc.roundedRect(15, startY, 180, 10, 2, 2, "F");
                
                doc.setFont("helvetica", "bold");
                doc.setFontSize(10);
                doc.setTextColor(255, 255, 255);
                doc.text("Level Menara", 25, startY + 7);
                doc.text("Soal Benar", 75, startY + 7);
                doc.text("Soal Salah", 115, startY + 7);
                doc.text("Skor Diperoleh", 155, startY + 7);
                
                let grandTotalScore = 0;
                let currentY = startY + 10;
                
                doc.setFont("helvetica", "normal");
                doc.setTextColor(30, 41, 59);
                
                for (let lvl = 1; lvl <= 4; lvl++) {
                    let lvlData = levelScoresHistory[lvl] || {score: 0, correct: 0, incorrect: 0};
                    grandTotalScore += lvlData.score;
                    let qCount = levelData[lvl].questions.length;
                    
                    if (lvl % 2 === 0) {
                        doc.setFillColor(248, 250, 252);
                        doc.rect(15, currentY, 180, 10, "F");
                    }
                    
                    doc.text(`Level ${lvl}`, 25, currentY + 7);
                    doc.text(`${lvlData.correct} / ${qCount}`, 78, currentY + 7);
                    doc.text(`${lvlData.incorrect}`, 118, currentY + 7);
                    doc.text(`${lvlData.score} / 100`, 155, currentY + 7);
                    
                    doc.setLineWidth(0.1);
                    doc.setDrawColor(226, 232, 240);
                    doc.line(15, currentY + 10, 195, currentY + 10);
                    currentY += 10;
                }
                
                let avgScore = (grandTotalScore / 4).toFixed(1);
                
                currentY += 8;
                doc.setFillColor(238, 242, 255);
                doc.roundedRect(15, currentY, 180, 16, 2, 2, "F");
                
                doc.setFont("helvetica", "bold");
                doc.setFontSize(10);
                doc.setTextColor(30, 41, 59);
                doc.text(`Total Skor Keseluruhan: ${grandTotalScore} / 400`, 22, currentY + 11);
                doc.text(`Rata-rata Skor: ${avgScore} / 100`, 125, currentY + 11);
                
                let sigY = currentY + 32;
                doc.setFont("helvetica", "normal");
                doc.setFontSize(10);
                doc.setTextColor(71, 85, 105);
                doc.text("Mengetahui,", 135, sigY);
                doc.text("Guru Mata Pelajaran Matematika,", 120, sigY + 6);
                
                doc.setFont("helvetica", "bold");
                doc.setTextColor(15, 23, 42);
                doc.text("Vyke Triawilly Pradista, S.Pd.", 120, sigY + 32);
                
                doc.setLineWidth(0.5);
                doc.setDrawColor(100, 100, 100);
                doc.line(120, sigY + 27, 185, sigY + 27);
                
                doc.setFontSize(8);
                doc.setTextColor(150, 150, 150);
                doc.text("Dokumen resmi ini dihasilkan secara otomatis oleh sistem Equations Jump", 105, 285, { align: "center" });
                
                doc.save(`Rekap_Nilai_${studentName.replace(/\s+/g, '_')}.pdf`);
            } catch (err) {
                alert("Gagal mencetak PDF. Pastikan browser mendukung ekspor PDF.");
                console.error(err);
            }
        }
    </script>
